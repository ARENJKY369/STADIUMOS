# FIFA World Cup 2026 - Stadium Operations Platform
# Environment Configuration Template
# Copy to .env and fill values

# Application
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME=Stadium Operations AI Platform
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database - PostgreSQL
DATABASE_URL=postgresql://stadium_user:stadium_pass@localhost:5432/stadium_ops
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stadium_ops
DB_USER=stadium_user
DB_PASSWORD=stadium_pass
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-64-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key-also-64-chars-minimum
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SESSION_SECRET=session-secret-32-chars-min

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:19006,exp://*
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# External APIs
CLAUDE_API_KEY=your-anthropic-claude-api-key
OPENAI_API_KEY=optional-openai-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
SENDGRID_API_KEY=your-sendgrid-key

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=ml-service-internal-key

# AWS S3 (Optional for production)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=stadium-ops-assets
AWS_CLOUDFRONT_URL=https://cdn.example.com

# Monitoring & Logging
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=optional-sentry-dsn
ENABLE_AUDIT_LOG=true

# Feature Flags
ENABLE_CHATBOT=true
ENABLE_ML_PREDICTIONS=true
ENABLE_ANALYTICS=true
ENABLE_SUSTAINABILITY=true
ENABLE_PUSH_NOTIFICATIONS=true

# FIFA Specific
TOURNAMENT_START_DATE=2026-06-11
TOURNAMENT_END_DATE=2026-07-19
DEFAULT_STADIUM_ID=
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,pt,ar,ja,ko,zh
