{
  "name": "stadium-operations-mobile",
  "version": "1.0.0",
  "description": "FIFA World Cup 2026 - Stadium Operations Mobile App - React Native",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "expo": "~49.0.15",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-native": "0.72.10",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-reanimated": "~3.3.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/drawer": "^6.6.6",
    "react-native-maps": "1.7.1",
    "@reduxjs/toolkit": "^2.0.1",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "axios": "^1.6.2",
    "socket.io-client": "^4.7.4",
    "@react-native-async-storage/async-storage": "1.18.2",
    "expo-location": "~16.1.0",
    "expo-notifications": "~0.20.1",
    "expo-secure-store": "~12.3.1",
    "expo-localization": "~14.3.0",
    "i18next": "^23.7.16",
    "react-i18next": "^13.5.0",
    "dayjs": "^1.11.10",
    "react-native-svg": "14.0.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-paper": "^5.12.3",
    "expo-haptics": "~12.4.0",
    "expo-image-picker": "~14.3.2",
    "expo-speech": "~11.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1"
  },
  "expo": {
    "name": "StadiumOS",
    "slug": "stadium-operations",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.fifa2026.stadiumops" },
    "android": { "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0f172a" }, "package": "com.fifa2026.stadiumops" },
    "web": { "favicon": "./assets/favicon.png" },
    "extra": { "apiUrl": "http://localhost:5000/api/v1", "socketUrl": "http://localhost:5000" }
  },
  "private": true
}
